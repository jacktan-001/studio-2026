{
  "name": "studio-2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jack Tan Studio 2026 — dark Pacome surface + Apple scroll narrative, persistent global audio, per-project themes.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
